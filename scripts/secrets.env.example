# secrets.env.example · 密钥模板（仓内 · 无真实值）
# 真实文件放 ~/.config/<工作空间目录名>/secrets.env（git 仓库外 · chmod 600）
# 消费方式：source scripts/load-secrets.sh && <命令>（必须同一条 shell 调用）
# /init-project 时按 PROJECT-PROFILE § 验收环境 增删变量名

# ── 验收环境入口 ──
ACCEPTANCE_BACKEND_BASE_URL=
ACCEPTANCE_ADMIN_BASE_URL=

# ── 验收测试账号 ──
ACCEPTANCE_ADMIN_USERNAME=
ACCEPTANCE_ADMIN_PASSWORD=

# ── 验收数据库（可写库才填）──
ACCEPTANCE_DB_HOST=
ACCEPTANCE_DB_PORT=
ACCEPTANCE_DB_USERNAME=
ACCEPTANCE_DB_PASSWORD=
ACCEPTANCE_DB_NAME=
