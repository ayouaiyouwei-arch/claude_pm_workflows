# RoboBus PM 自跑回归 · 环境变量样例
# 复制为 .env（不要 commit）· dotenv 自动加载 · 见 README-PM自跑.md § 一
# -----------------------------------------------------------------------------

# === 环境切换 ===
# staging（默认 · HTTPS 灰度 · 沿用 P006 § 二）/ local（本地 docker-compose）
PLAYWRIGHT_ENV=staging

# baseURL 显式覆盖（可选 · 留空则按 PLAYWRIGHT_ENV 自动选）
# ADMIN_BASE_URL=https://robobus.chelaile.net.cn

# 基线版本号（决定 reports/ 归档目录）
BASELINE_VERSION=B1.1.2

# 单用例超时 ms（默认 300_000 = 5min · 真实 UI 增删改用例可拉到 600_000）
# PW_TIMEOUT_MS=300000

# === P006 § 三 5 角色账号 ===
# 默认值已写死在 fixtures/auth.ts（统一口令 robobus2026）
# 只有在你需要切换灰度/正式账号 / 个人账号时 才用 env 覆盖

# PM_GRAY_ADMIN_USER=gray_admin
# PM_GRAY_ADMIN_PASSWORD=robobus2026
#
# PM_DISPATCHER01_USER=dispatcher01
# PM_DISPATCHER01_PASSWORD=robobus2026
#
# PM_SUPERVISOR01_USER=supervisor01
# PM_SUPERVISOR01_PASSWORD=robobus2026
#
# PM_LEADER01_USER=leader01
# PM_LEADER01_PASSWORD=robobus2026
#
# PM_OFFICER01_USER=officer01
# PM_OFFICER01_PASSWORD=robobus2026
